{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "description": "Wait a week before adopting a release, so compromised or broken releases are usually pulled first; vulnerability fixes skip the wait",
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "customDatasources": {
    "gcloud": {
      "defaultRegistryUrlTemplate": "https://dl.google.com/dl/cloudsdk/channels/rapid/components-2.json",
      "transformTemplates": ["{\"releases\": [{\"version\": version}]}"]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "mise itself, pinned in .make.d/mise.mk",
      "managerFilePatterns": ["/^\\.make\\.d/mise\\.mk$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nMISE_VERSION := (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "gcloud, installed through mise's http backend",
      "managerFilePatterns": ["/^configs/\\.config/mise/config\\.desktop\\.toml$/"],
      "matchStrings": [
        "\\[tools\\.\"http:gcloud\"\\]\\nversion = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "custom.gcloud",
      "depNameTemplate": "gcloud",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Container test image, pinned by digest like the CI images",
      "managerFilePatterns": ["/^tests/test-install-container\\.sh$/"],
      "matchStrings": [
        "IMAGE=\"\\$\\{IMAGE:-(?<depName>[^:]+):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)\\}\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "mise ships near-daily; take it monthly",
      "matchDepNames": ["jdx/mise"],
      "schedule": ["* 0-5 1 * *"]
    },
    {
      "description": "The gcloud feed has no release timestamps, which minimumReleaseAge requires",
      "matchDatasources": ["custom.gcloud"],
      "minimumReleaseAge": null
    }
  ]
}
