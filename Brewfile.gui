################################################################################
# Brewfile for GUI Applications
#
# This is an alternative to managing GUI apps via the Makefile.
# Brewfile provides a declarative way to manage Homebrew packages.
#
# Usage:
#   brew bundle install --file=Brewfile.gui      # Install all apps
#   brew bundle cleanup --file=Brewfile.gui      # Remove unlisted apps
#   brew bundle dump --file=Brewfile.gui --force # Generate from current installs
#
# To integrate with Makefile, add this target to gui-apps.mk:
#   .PHONY: install-from-brewfile
#   install-from-brewfile:
#   	brew bundle install --file=Brewfile.gui
#
################################################################################

