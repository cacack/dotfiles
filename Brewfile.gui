################################################################################
# Brewfile for desktop GUI apps: every desktop, work included (`make desktop`).
# Personal-only apps live in Brewfile.personal (`make personal`).
#
# Usage:
#   brew bundle install --file=Brewfile.gui      # Install all apps
#   brew bundle cleanup --file=Brewfile.gui      # Remove unlisted apps
################################################################################

# Install into ~/Applications: no admin rights needed.
# Casks that ship a .pkg installer still need admin.
# adopt: take over an identical app already there (e.g. installed by hand).
cask_args appdir: "~/Applications", adopt: true

# Bitwarden is installed from the Mac App Store, not the Homebrew cask: the cask
# is auto_updates and fights the App Store / in-app self-updater, which breaks
# `brew upgrade`. `mas` lets `brew bundle` reproduce the App Store install.
# Requires being signed in to the App Store. id from: mas list / app metadata.
brew "mas"
mas "Bitwarden", id: 1352778147

cask "claude"
cask "ghostty"
cask "spotify"

# Mark Text: the cask was disabled 2026-09-01 (fails Gatekeeper), so it cannot
# be installed from here.
