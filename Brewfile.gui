################################################################################
# Brewfile for desktop GUI apps: every desktop, work included (`make desktop`).
# Personal-only apps live in Brewfile.personal (`make personal`).
#
# Usage:
#   brew bundle install --file=Brewfile.gui      # Install all apps
#   brew bundle cleanup --file=Brewfile.gui      # Remove unlisted apps
################################################################################

# Install into ~/Applications: no admin rights needed.
# Casks that ship a .pkg installer still need admin.
# adopt: take over an identical app already there (e.g. installed by hand).
cask_args appdir: "~/Applications", adopt: true

# Bitwarden is the cask, not the App Store app, which needs a usable Mac App
# Store. Don't mix the two on one Mac: a root-owned App Store copy in
# /Applications breaks `brew upgrade` of the cask.
cask "bitwarden"
cask "claude"
cask "ghostty"
cask "spotify"

# Nerd Fonts (into ~/Library/Fonts); Linux downloads them in fonts.mk.
cask "font-3270-nerd-font"
cask "font-fira-code-nerd-font"
cask "font-hack-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-meslo-lg-nerd-font"
cask "font-mononoki-nerd-font"
cask "font-proggy-clean-tt-nerd-font"
